<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-transfer rules for API 31+.

    The Pro entitlement cache (`billing_prefs`, holding `is_pro`) is excluded from both paths for
    the same reason: it unlocks premium features before Google Play has been consulted, so
    restoring it would grant Pro on a device that never paid — and on an offline device the flag
    would never be corrected. Play is the only source of entitlement; user settings restore freely.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="billing_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="billing_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
