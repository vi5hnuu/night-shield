<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto-backup rules for API 30 and below (API 31+ uses data_extraction_rules.xml).

    Everything is backed up except the Pro entitlement cache: `billing_prefs` holds the
    `is_pro` flag that unlocks premium features before Google Play has been consulted. Backing
    it up would carry a granted entitlement onto a restored device — including one signed into a
    different Google account, or one that never reaches Play to have the flag corrected.
    Entitlement must always come from Play, never from a restored file.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="billing_prefs.xml" />
</full-backup-content>
